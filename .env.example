# Firebase Auth (Google, Apple y email). Sin estas variables la app funciona en
# modo demo, con perfiles locales de este navegador.
# Consola de Firebase > Configuración del proyecto > Tus apps > Configuración SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
