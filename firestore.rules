rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Planes compartidos. El id es un UUID: quien tiene el enlace puede unirse.
    match /shared/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;

      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // Los miembros editan todo; quien no es miembro solo puede añadirse a sí mismo.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
            && request.auth.uid in request.resource.data.members)
      );

      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
